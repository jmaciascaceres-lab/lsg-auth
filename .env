# Base de datos MySQL
DB_NAME=db_lsg
DB_USER=lsg_user
DB_PASSWORD=userpassword

# JWT
AUTH_JWT_SECRET=xaA38suwZjN-W0G658G307tmxrXG5tLN8h0v77BHFmWpk9pt1DNrC3tEURiCqvyzDbd8_UuIPeIQvNLuDEm8nw
AUTH_JWT_ALGORITHM=HS256

# Claim 'iss' del token emitido
AUTH_JWT_ISSUER=lsg-auth
# Claim 'aud' del token emitido (validado por lsg-core-api-prod)
AUTH_JWT_AUDIENCE=lsg-core-api

# Expiración del token de acceso (v1.1+: 10 minutos)
# En desarrollo local puedes subirlo temporalmente (ej: 60)
JWT_EXPIRE_MINUTES=10

# Guards
# false en producción. true solo si necesitas iniciar sesión sin BD de auth
# (devuelve admin ficticio, NUNCA en producción)
AUTH_DISABLED=false

